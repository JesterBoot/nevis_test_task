POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nevis
POSTGRES_USER=nevis
POSTGRES_PASSWORD=nevis
POSTGRES_DATA_DIR=/var/lib/postgresql/data
POSTGRES_VOLUME=nevis_postgres_data
API_PORT=8080
API_HOST=0.0.0.0
API_CONTAINER_PORT=8080
DEBUG=0
API_HEALTHCHECK_INTERVAL=10s
API_HEALTHCHECK_TIMEOUT=5s
API_HEALTHCHECK_RETRIES=10
API_HEALTHCHECK_START_PERIOD=15s
MODEL_VOLUME=nevis_model_cache
DB_HEALTHCHECK_INTERVAL=5s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=1

# Local
DATABASE_URL=sqlite:///./nevis.db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
MODEL_CACHE_DIR=./model-cache
MODEL_READY_FILE=./model-cache/.model-ready
DOCKER_MODEL_CACHE_DIR=/opt/models
DOCKER_MODEL_READY_FILE=/opt/models/.model-ready
MAX_DOCUMENT_CHARS=50000
MAX_CHUNKS=100
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
SEARCH_LIMIT_DEFAULT=10
SEARCH_LIMIT_MAX=50
FTS_BOOST=0.10
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
DOCKER_HF_HUB_OFFLINE=1
DOCKER_TRANSFORMERS_OFFLINE=1
